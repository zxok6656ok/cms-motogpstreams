// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`


model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  id          String   @id @default(cuid())
  siteName    String
  title       String
  description String?
  siteUrl     String?
  logo        String?
  favicon     String?
  ogImage     String?

  hero        HeroSetting?

  playerNoticeTitle       String?
  playerNoticeDescription String?

  googleAnalyticsId     String?
  googleSiteVerification String?


  telegramTitle       String?
  telegramDescription String?

  socialLinks SocialLink[]
  navbarItems NavbarItem[]
  footerItems FooterItem[]
  adLinks     AdLink[]

  metaTitle       String?
  metaDescription String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSetting {
  id String @id @default(cuid())

  siteId String @unique
  site   SiteSetting @relation(fields: [siteId],references: [id],onDelete: Cascade)

  badge       String?
  title       String?
  subtitle    String?
  year        String?
  description String?
  
  primaryButtonText   String?
  primaryButtonUrl    String?

  secondaryButtonText String?
  secondaryButtonUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum AdPosition {
  head
  body
}

model AdLink {
  id            String @id @default(uuid())
  name          String
  url           String
  order         Int    @default(0)
  position      AdPosition @default(body)
  isActive   Boolean          @default(true)
  siteSettingId String
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteSettingId])
  @@map("ad_links")
}

model SocialLink {
  id            String @id @default(uuid())
  name          String
  platform      SocialPlatform
  url           String

  siteSettingId String
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteSettingId])
  @@map("social_links")
}

model NavbarItem {
  id            String @id @default(uuid())
  name          String
  url           String
  order         Int    @default(0)

  siteSettingId String
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteSettingId])
  @@map("navbar_items")
}

model FooterItem {
  id            String @id @default(uuid())
  name          String
  url           String
  order         Int    @default(0)

  siteSettingId String
  siteSetting   SiteSetting @relation(fields: [siteSettingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteSettingId])
  @@map("footer_items")
}

enum AdWidgetPosition {
  head
  body
  article
  sidebar
  floating
  footer
}

model AdWidget {
  id         String           @id @default(uuid())
  name       String
  htmlCode   String?          @db.Text
  scriptCode String?          @db.Text

  position   AdWidgetPosition
  order      Int              @default(0)
  isActive   Boolean          @default(true)

  height     Int              @default(90)
  maxWidth   String           @default("md")
  mobileOnly Boolean          @default(true)
  showClose  Boolean          @default(true)

  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([position, isActive])
  @@map("ad_widgets")
}

enum SocialPlatform {
  telegram
  facebook
  instagram
  twitter
  youtube
  tiktok
  pinterest
}

model Article {
  id             String     @id @default(uuid())
  title          String
  slug           String     @unique
  metaDescription String?
  thumbnail  String?
  poster String?
  status      StatusArticle @default(publish)
  content        String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  uploadBy       String @default("X")

  categories     Category[]
  streams        Stream[]

  @@index([createdAt])
  @@map("articles")
}
enum StatusArticle {
  publish
  draft
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  articles  Article[]

  @@map("categories")
}

model Stream {
  id        String   @id @default(uuid())
  name      String
  type      StreamType
  url       String
  drmId String?
  drmKey String?
  articleId String
  directLink String? @default("")
  directLinkActive Boolean @default(false)

  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([articleId])
  @@map("streams")
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
}

enum StreamType {
  hls
  dash
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
